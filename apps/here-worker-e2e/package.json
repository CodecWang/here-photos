{
  "name": "@here-photos/here-worker-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "here-worker-e2e",
    "implicitDependencies": [
      "here-worker"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/here-worker-e2e/jest.config.ts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "here-worker:build",
          "here-worker:serve"
        ]
      }
    }
  }
}

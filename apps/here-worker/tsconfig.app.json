{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "paths": {
      "@here-photos/db": ["../../libs/db/src/index.ts"],
      "@here-photos/queue": ["../../libs/queue/src/index.ts"],
      "@here-photos/thumb-hash": ["../../libs/thumb-hash/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../libs/db/src/**/*.ts",
    "../../libs/queue/src/**/*.ts",
    "../../libs/thumb-hash/src/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "../../libs/db/src/**/*.spec.ts",
    "../../libs/queue/src/**/*.spec.ts",
    "../../libs/thumb-hash/src/**/*.spec.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/thumb-hash/tsconfig.lib.json"
    },
    {
      "path": "../../libs/db/tsconfig.lib.json"
    },
    {
      "path": "../../libs/queue/tsconfig.lib.json"
    }
  ]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    // "module": "nodenext",
    "types": ["node"],
    "rootDir": ".",
    // "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "paths": {
      "@here-photos/thumb-hash": ["../../libs/thumb-hash/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../libs/thumb-hash/src/**/*.ts"],
  "exclude": [

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Album {
  id         Int          @id @default(autoincrement())
  albumId    String       @unique(map: "albumId") @db.Char(8)
  title      String       @db.Char(64)
  coverId    Int?
  pinned     Boolean?     @default(false)
  createdAt  DateTime?    @default(now()) @db.DateTime(0)
  updatedAt  DateTime?    @default(now()) @db.DateTime(0)
  Photo      Photo?       @relation(fields: [coverId], references: [id], onDelete: Cascade, map: "Album_ibfk_1")
  AlbumPhoto AlbumPhoto[]

  @@index([coverId], map: "coverId")
}

model AlbumPhoto {
  albumId   Int
  photoId   Int
  createdAt DateTime? @default(now()) @db.DateTime(0)
  updatedAt DateTime? @default(now()) @db.DateTime(0)
  Album     Album     @relation(fields: [albumId], references: [id], onDelete: Cascade, map: "AlbumPhoto_ibfk_1")
  Photo     Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade, map: "AlbumPhoto_ibfk_2")

  @@id([albumId, photoId])
  @@index([photoId], map: "photoId")
}

model Exif {
  id           Int       @id @default(autoincrement())
  photoId      Int       @unique(map: "photoId")
  shotTime     DateTime? @db.DateTime(0)
  cameraMake   String?   @db.VarChar(50)
  cameraModel  String?   @db.VarChar(50)
  iso          Int?      @db.SmallInt
  gpsLatitude  Float?    @db.Float
  gpsLongitude Float?    @db.Float
  createdAt    DateTime? @default(now()) @db.DateTime(0)
  updatedAt    DateTime? @default(now()) @db.DateTime(0)
  Photo        Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade, map: "Exif_ibfk_1")
}

model Photo {
  id           Int          @id @default(autoincrement())
  photoId      String       @unique(map: "photoId") @db.Char(8)
  filePath     String       @unique(map: "filePath") @db.VarChar(255)
  checkSum     String       @db.Char(32)
  blurHash     String?      @db.VarChar(32)
  shotTime     DateTime?    @db.DateTime(0)
  modifiedTime DateTime     @db.DateTime(0)
  createdAt    DateTime?    @default(now()) @db.DateTime(0)
  updatedAt    DateTime?    @default(now()) @db.DateTime(0)
  Album        Album[]
  AlbumPhoto   AlbumPhoto[]
  Exif         Exif?
  Thumbnail    Thumbnail[]
}

model Setting {
  id        Int       @id @default(autoincrement())
  key       String    @unique(map: "key") @db.Char(32)
  value     String?   @db.Text
  createdAt DateTime? @default(now()) @db.DateTime(0)
  updatedAt DateTime? @default(now()) @db.DateTime(0)
}

model Thumbnail {
  id        Int       @id @default(autoincrement())
  photoId   Int
  filePath  String    @db.VarChar(255)
  variant   Int       @db.TinyInt
  size      Int
  width     Int       @db.SmallInt
  height    Int       @db.SmallInt
  format    String    @db.VarChar(50)
  createdAt DateTime? @default(now()) @db.DateTime(0)
  updatedAt DateTime? @default(now()) @db.DateTime(0)
  Photo     Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade, map: "Thumbnail_ibfk_1")

  @@index([photoId], map: "photoId")
}

model ScanTask {
  id        Int       @id @default(autoincrement())
  taskId    String    @unique(map: "taskId") @db.Char(8)
  status    Int       @default(1) @db.TinyInt
  total     Int       @default(0)
  processed Int       @default(0)
  success   Int       @default(0)
  failed    Int       @default(0)
  createdAt DateTime? @default(now()) @db.DateTime(0)
  updatedAt DateTime? @default(now()) @db.DateTime(0)
}

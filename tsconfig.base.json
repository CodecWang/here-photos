{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@here-photos/source"],
    "paths": {
      "@here-photos/db": ["libs/db/src/index.ts"],
      "@here-photos/queue": ["libs/queue/src/index.ts"],
      "@here-photos/thumb-hash": ["libs/thumb-hash/src/index.ts"]
    }
  }
}
